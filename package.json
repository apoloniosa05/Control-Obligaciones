{
  "name": "controlobligaciones45",
  "version": "1.0.0",
  "description": "Sistema de Control de Obligaciones Fiscales - MACH Contadores Públicos",
  "type": "module",
  "scripts": {
    "build": "node -e \"const fs=require('fs'); if(!fs.existsSync('public')){fs.mkdirSync('public');} fs.copyFileSync('index.html', 'public/index.html');\"",
    "dev": "netlify dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "esbuild scripts/seed-admin.ts --bundle --platform=node --format=esm --outfile=scripts/seed-admin.mjs && node scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.0",
    "@netlify/identity": "^2.0.0",
    "drizzle-orm": "^1.0.0-beta.22"
  },
  "devDependencies": {
    "drizzle-kit": "^1.0.0-beta.22"
  },
  "private": true
}
